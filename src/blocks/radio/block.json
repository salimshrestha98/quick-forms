{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "quick-forms/radio",
	"version": "0.1.0",
	"title": "Radio",
	"category": "quick-forms",
	"icon": "editor-ul",
	"description": "Radio Field",
	"parent": [
		"quick-forms/form"
	],
	"example": {},
	"supports": {
		"html": false
	},
	"attributes": {
		"id": {
			"type": "string"
		},
		"fieldLabel": {
			"type": "string",
			"default": "Radio"
		},
		"options": {
			"type": "string",
			"default": ""
		},
		"optionsLayout": {
			"type": "string",
			"default": "inline"
		},
		"defaultValue": {
			"type": "string",
			"default": ""
		},
		"required": {
			"type": "boolean",
			"default": false
		}
	},
	"inputdomain": "quick-forms",
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}