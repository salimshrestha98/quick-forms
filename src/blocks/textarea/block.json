{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "nnforms/textarea",
	"version": "0.1.0",
	"title": "Textarea",
	"category": "nnforms",
	"icon": "editor-paragraph",
	"description": "Textarea Field",
	"parent": [
		"nnforms/form"
	],
	"example": {},
	"supports": {
		"html": false
	},
	"attributes": {
		"id": {
			"type": "string"
		},
		"fieldLabel": {
			"type": "string",
			"default": "Textarea"
		},
		"rowsCount": {
			"type": "number",
			"default": 5
		},
		"placeholder": {
			"type": "string",
			"default": ""
		},
		"defaultValue": {
			"type": "string",
			"default": ""
		},
		"required": {
			"type": "boolean",
			"default": false
		},
		"maxLength": {
			"type": "number",
			"default": 500
		}
	},
	"inputdomain": "nnforms",
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}