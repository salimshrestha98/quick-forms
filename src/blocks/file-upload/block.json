{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "nnforms/file-upload",
	"version": "0.1.0",
	"title": "File Upload",
	"category": "nnforms",
	"icon": "cloud-upload",
	"description": "File Upload Field",
	"parent": [
		"nnforms/form"
	],
	"example": {},
	"supports": {
		"html": false
	},
	"attributes": {
		"id": {
			"type": "string"
		},
		"fieldLabel": {
			"type": "string",
			"default": "File Upload"
		},
		"placeholder": {
			"type": "string",
			"default": ""
		},
		"required": {
			"type": "boolean",
			"default": false
		},
		"accept": {
			"type": "string",
			"default": ""
		},
		"multiple": {
			"type": "boolean",
			"default": false
		}
	},
	"inputdomain": "nnforms",
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}