{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "nnforms/submit",
	"version": "0.1.0",
	"title": "Submit",
	"category": "nnforms",
	"icon": "arrow-right-alt",
	"description": "Submit Button",
	"parent": [
		"nnforms/form"
	],
	"example": {},
	"supports": {
		"html": false
	},
	"attributes": {
		"id": {
			"type": "string"
		},
		"buttonText": {
			"type": "string",
			"default": "Submit"
		},
		"buttonWidthType": {
			"type": "string",
			"default": "custom"
		},
		"buttonWidth": {
			"type": "string",
			"default": "100px"
		},
		"textColor": {
			"type": "string",
			"default": "#000000"
		},
		"bgColor": {
			"type": "string",
			"default": "#e7e7e7"
		},
		"padding": {
			"type": "object",
			"default": {
				"top": "15px",
				"left": "20px",
				"right": "20px",
				"bottom": "15px"
			}
		}
	},
	"textdomain": "nnforms",
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}