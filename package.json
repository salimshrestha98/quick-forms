{
	"name": "quick-forms",
	"version": "1.0.0",
	"description": "A native Gutenberg block-based form builder. Build forms directly inside the block editor — no shortcodes, no iframes.",
	"author": "salimlabscode",
	"license": "GPL-2.0-or-later",
	"main": "build/index.js",
	"scripts": {
		"build": "wp-scripts build --blocks-manifest && node esbuild.js",
		"start": "concurrently \"wp-scripts start --blocks-manifest\" \"node esbuild.js --watch\"",
		"format": "wp-scripts format",
		"lint": "eslint .",
		"lint-fix": "eslint . --fix",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip"
	},
	"dependencies": {
		"@wordpress/block-editor": "latest",
		"@wordpress/blocks": "latest",
		"@wordpress/i18n": "latest"
	},
	"devDependencies": {
		"@wordpress/eslint-plugin": "^24.5.0",
		"@wordpress/scripts": "^31.8.0",
		"concurrently": "^9.2.1",
		"esbuild": "^0.28.0",
		"esbuild-sass-plugin": "^3.7.0",
		"eslint": "^8.57.1",
		"sass": "^1.99.0"
	}
}